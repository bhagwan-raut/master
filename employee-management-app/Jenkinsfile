pipeline {
    agent any
    tools {
        jdk 'JDK21'
        maven 'Maven'
    }
    environment {
        DEPLOY_DIR = 'C:\\deploy'
        APP_NAME   = 'employee-management-app.jar'
        APP_PORT   = '8085'
        BUILD_VER  = "1.0.${BUILD_NUMBER}"
    }
    stages {
        stage('Clone Code') {
            steps {
                git branch: 'employee-management-app',
                    credentialsId: 'github-ssh',
                    url: 'git@github.com:bhagwan-raut/master.git'
            }
        }
        stage('Set Version') {
            steps {
                dir('employee-management-app') {
                    bat "mvn versions:set -DnewVersion=${BUILD_VER}"
                }
            }
        }
        stage('Build JAR') {
            steps {
                dir('employee-management-app') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }
        stage('Test') {
            steps {
                dir('employee-management-app') {
                    bat 'mvn test'
                }
            }
        }
        stage('Stop Old App') {
            steps {
                bat '''
                    echo --- killing any process on port 8085 ---
                    for /L %%i in (1,1,10) do (
                        set "FOUND="
                        for /f "tokens=5" %%a in ('netstat -aon ^| findstr ":8085"') do (
                            taskkill /PID %%a /F 2>nul
                            set "FOUND=1"
                        )
                        if not defined FOUND goto :portclear
                        timeout /t 2 /nobreak >nul
                    )
                    :portclear
                    echo --- verifying port 8085 is free ---
                    netstat -aon | findstr ":8085"
                    timeout /t 3 /nobreak
                    exit 0
                '''
            }
        }
        stage('Deploy JAR') {
            steps {
                bat 'if not exist %DEPLOY_DIR% mkdir %DEPLOY_DIR%'
                dir('employee-management-app') {
                    bat '''
                        echo --- jar files in target before copy ---
                        dir target\\*.jar
                        echo --- running copy (explicit filename) ---
                        copy /Y target\\employee-management-app.jar %DEPLOY_DIR%\\%APP_NAME%
                        echo --- result after copy ---
                        dir %DEPLOY_DIR%\\%APP_NAME%
                    '''
                }
            }
        }
        stage('Start App') {
            steps {
                bat """
                    echo @echo off > %DEPLOY_DIR%\\start-app.bat
                    echo start /B "C:\\Program Files\\Java\\jdk-21.0.11\\bin\\java.exe" -jar %DEPLOY_DIR%\\%APP_NAME% >> %DEPLOY_DIR%\\start-app.bat
                    %DEPLOY_DIR%\\start-app.bat
                """
                echo "App version ${BUILD_VER} started at http://localhost:8085"
            }
        }
        stage('Commit Build Number') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-credentials',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    bat """
                        git config user.email "bhagwanraut0597@gmail.com"
                        git config user.name "bhagwan-raut"
                        echo ${BUILD_VER} > build-version.txt
                        git add build-version.txt
                        git commit -m "Jenkins Build - Version ${BUILD_VER}"
                        git push https://%GIT_USER%:%GIT_TOKEN%@github.com/bhagwan-raut/master.git HEAD:employee-management-app
                    """
                }
            }
        }
    }
    post {
        success {
            echo "✅ Build ${BUILD_VER} Successful!"
            echo "Access at: http://localhost:8085/api/employees"
        }
        failure {
            echo "❌ Build ${BUILD_VER} Failed!"
        }
    }
}
